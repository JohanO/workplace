@page "/connections"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@inject ConnectedAccountsService AccountsService
@inject CalendarColorService CalendarColorService
@using Workplace.Web.Agenda
@using Workplace.Web.CalendarConnections

<PageTitle>Connections</PageTitle>

<h1>Connected Calendars</h1>

@if (accounts is null || calendars is null)
{
    <p>Loading…</p>
}
else if (accounts.Count == 0)
{
    <p>No calendars connected yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Provider</th>
                <th>Account</th>
                <th>Display name</th>
                <th>Granted scopes</th>
                <th>Status</th>
                <th>Colour</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var account in accounts)
            {
                var key = CalendarColorService.AccountKey(account.Id);
                <tr>
                    <td>@account.Provider</td>
                    <td>@account.DisplayLabel</td>
                    <td>
                        <input type="text" size="12" value="@calendars[key].DisplayLabel"
                               @onchange="e => SetDisplayNameAsync(key, (string)e.Value!)" />
                    </td>
                    <td>@account.GrantedScopes</td>
                    <td>
                        @if (account.LastRefreshError is not null)
                        {
                            <span class="text-danger">@account.LastRefreshError</span>
                        }
                        else
                        {
                            <span class="text-success">OK</span>
                        }
                    </td>
                    <td>
                        <input type="color" value="@calendars[key].Color"
                               @onchange="e => SetColorAsync(key, (string)e.Value!)" />
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DisconnectAsync(account.Id)">Disconnect</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Connect an account</h2>
<ul>
    <li><a href="connect/MicrosoftGraphPersonal" data-enhance-nav="false">Connect my personal Microsoft calendar (read-write)</a></li>
    <li><a href="connect/MicrosoftGraphWork" data-enhance-nav="false">Connect a work Microsoft calendar (read-only)</a></li>
    <li><a href="connect/GoogleCalendar" data-enhance-nav="false">Connect Google Calendar (read-only)</a></li>
</ul>

@if (calendars is not null)
{
    <h2>Work calendar</h2>
    <p>
        <input type="color" value="@calendars[CalendarColorService.WorkCalendarKey].Color"
               @onchange="e => SetColorAsync(CalendarColorService.WorkCalendarKey, (string)e.Value!)" />
        <input type="text" size="12" value="@calendars[CalendarColorService.WorkCalendarKey].DisplayLabel"
               @onchange="e => SetDisplayNameAsync(CalendarColorService.WorkCalendarKey, (string)e.Value!)" />
        Used for events synced from Outlook.
    </p>
}

@code {
    private List<ConnectedAccountResponse>? accounts;
    private Dictionary<string, CalendarSource>? calendars;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        accounts = await AccountsService.GetAccountsAsync();
        calendars = (await CalendarColorService.GetCalendarsAsync()).ToDictionary(c => c.Key);
    }

    private async Task DisconnectAsync(Guid id)
    {
        await AccountsService.DisconnectAsync(id);
        await LoadAsync();
    }

    private async Task SetColorAsync(string calendarKey, string color)
    {
        await CalendarColorService.SetColorAsync(calendarKey, color);
        await LoadAsync();
    }

    private async Task SetDisplayNameAsync(string calendarKey, string displayName)
    {
        await CalendarColorService.SetDisplayNameAsync(calendarKey, displayName);
        await LoadAsync();
    }
}
