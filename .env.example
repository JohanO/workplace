# ─── Docker Hub ─────────────────────────────────────────────────────────────
# Your Docker Hub username. Images are pulled as:
#   USERNAME/workplace-api:IMAGE_TAG
#   USERNAME/workplace-web:IMAGE_TAG
DOCKERHUB_USERNAME=your_dockerhub_username

# Tag to pull. GitHub Actions pushes both 'latest' and the full commit SHA.
# Use the SHA tag to pin a specific build, or 'latest' to always get the newest.
IMAGE_TAG=latest

# ─── Microsoft Entra ID (AzureAd) ───────────────────────────────────────────
# App registration → Certificates & secrets → Client Secret
AZURE_AD_CLIENT_SECRET=your_azure_ad_client_secret

# ─── Google Calendar ─────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client secret
GOOGLE_CLIENT_SECRET=your_google_client_secret

# No CLOUDFLARE_TUNNEL_TOKEN here — this app doesn't run its own cloudflared.
# It joins talktrack's shared cf-ingress network instead (see docker-compose.yml).
# Add a public hostname route for this app in the Cloudflare dashboard:
#      Public hostname: yourdomain.com
#      Service type:    HTTP
#      URL:             webfrontend:8080
